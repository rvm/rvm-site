%nav.toc{ "aria-label": "Blog posts" }
  %details.toc__wrap
    %summary.toc__toggle All posts
    .toc__body
      %ul.toc__posts
        - sorted_articles.each do |post|
          %li
            %a{ href: post.path, "aria-current": (post.path == @item.path ? "page" : nil) }
              = post[:title]
            %time{ datetime: attribute_to_time(post[:created_at]).strftime('%F') }= get_pretty_date(post)
