%a.skip{ href: "#main" } Skip to content
%header.bar
  .container.bar__in
    %a.wordmark{ href: "/" }
      %img{ src: "/images/logo.png", alt: "", width: "40", height: "40" }
      %span RVM
    %form.search{ role: "search", action: "https://duckduckgo.com/", method: "get" }
      %label.visually-hidden{ for: "docsearch-input" } Search the documentation
      %input#docsearch-input{ type: "search", name: "q", placeholder: "Search the documentation", autocomplete: "off" }
    %nav.bar__nav{ "aria-label": "Primary" }
      %a{ href: "/rvm/install/" } Install
      %a{ href: "/blog/" } Blog
      %a{ href: "/support/" } Support
      %a{ href: "https://github.com/rvm/rvm" } GitHub
