!!! 5
%html{ lang: "en" }
  = render "/shared/html-head/"
  %body
    = render "/shared/header/"
    .container.docs
      - if @item.path.to_s.start_with?("/blog/")
        = render "/shared/blog_menu/"
      - else
        = render "/shared/doc_menu/"
      %main#main.docs__main.prose
        = yield
    = render "/shared/footer/"
