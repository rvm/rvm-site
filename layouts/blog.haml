!!! 5
%html{ lang: "en" }
  = render "/shared/html-head/"
  %body
    = render "/shared/header/"
    .container.docs
      = render "/shared/blog_menu/"
      %main#main.docs__main.prose
        %article
          %header.post__head
            %h1= item[:title]
            - if item[:created_at] || item[:author]
              %p.post__meta= get_post_meta(item)
          = yield
    = render "/shared/footer/"
