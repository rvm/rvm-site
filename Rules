#!/usr/bin/env ruby

# Nanoc 4 rules, using legacy identifiers (/foo/) and legacy string patterns so
# the existing content tree keeps its URLs unchanged.

HAML = { escape_html: false }.freeze

preprocess do
  AutoHelper.new(__dir__, @items, @layouts).auto
end

# --- Assets -------------------------------------------------------------------

# Plain CSS, copied as-is to /css/<name>.css
compile '/assets/css/*/' do
end

route '/assets/css/*/' do
  item.identifier.to_s.chop.sub(%r{^/assets}, '') + '.css'
end

%w[assets/images assets/javascripts assets/fonts].each do |asset_dir|
  compile "/#{asset_dir}/*/" do
  end

  route "/#{asset_dir}/*/" do
    item.identifier.to_s.chop.sub(%r{^/assets}, '') + '.' + item[:extension]
  end
end

# --- Blog ---------------------------------------------------------------------

compile '/blog/feed/' do
  filter :haml, HAML
end

route '/blog/feed/' do
  '/blog/feed.xml'
end

compile '/blog/' do
  filter :haml, HAML
  filter :auto_ids
  filter :pre_code
  filter :rvm_issues
  layout '/default/'
end

compile '/blog/*/' do
  filter :rdiscount
  filter :pre_code
  filter :rvm_issues
  layout '/blog/'
  filter :auto_ids
end

blog_regexp = %r{/blog/([0-9]+)-([0-9]+)-([0-9]+)-([^/]+)}
route blog_regexp do
  y, m, _d, slug = blog_regexp.match(item.identifier.to_s).captures
  "/blog/#{y}/#{m}/#{slug}/index.html"
end

# --- Tag and author pages (generated by lib/auto.rb) --------------------------

news_regexp = %r{/(authors|tags)/(.*)_feed/}

compile news_regexp do
  filter :haml, HAML
end

route news_regexp do
  type, filter = news_regexp.match(item.identifier.to_s).captures
  "/#{type}/#{filter}/feed.xml"
end

compile '/(authors|tags)/*/' do
  filter :haml, HAML
  filter :pre_code
  layout '/blog/'
  filter :auto_ids
end

# --- Verbatim files -----------------------------------------------------------

{
  '/robots/'                 => '/robots.txt',
  '/assets/favicon/'         => '/favicon.ico',
  '/google0e4a57f3096204a2/' => '/google0e4a57f3096204a2.html',
  '/digicert/verify/'        => '/digicert/verify.html',
}.each do |identifier, url|
  compile identifier do
  end

  route identifier do
    url
  end
end

Dir['content/license/*.txt', 'content/keybase.txt', 'content/*.asc'].each do |file|
  file = file.delete_prefix('content')
  identifier = file.sub(/\.[^.]+$/, '') + '/'

  compile identifier do
  end

  route identifier do
    file
  end
end

# --- Documentation pages ------------------------------------------------------

compile '*' do
  case item[:extension]
  when 'md'
    filter :rdiscount
    filter :auto_ids
    filter :pre_code
  when 'haml'
    filter :haml, HAML
  end
  layout "/#{item[:layout] || 'default'}/"
end

route '*' do
  item.identifier.to_s + 'index.html'
end

layout '*', :haml, HAML
